# CONFIG APP
PORT=
HOST=

JWT_SECRET_KEY=
DEBUG_TO_FILE=false

DB_SSL_MASTER=
DB_HOST_MASTER=
DB_PORT_MASTER=
DB_USER_MASTER=
DB_PASSWORD_MASTER=
DB_NAME_MASTER=
DB_TIMEZONE_MASTER=

DB_SSL_SLAVE=
DB_HOST_SLAVE=
DB_PORT_SLAVE=
DB_USER_SLAVE=
DB_PASSWORD_SLAVE=
DB_NAME_SLAVE=
DB_TIMEZONE_SLAVE=

DOCAPI_HOST=localhost
DOCAPI_PORT=8082
WSAPI_HOST=localhost
WSAPI_PORT=8087

# BERKAITAN DENGAN KEBUTUHAN BACKGROUND WORKER
# Waktu tunggu (detik) untuk request gRPC yang sedang berjalan selesai saat server shutdown
GRPC_STOP_GRACE_SECONDS=10

# Batas umur (menit) job berstatus 'processing' sebelum dianggap macet & di-requeue ke 'pending'
STALE_TIMEOUT_MINUTES=10

# Jeda (detik) antar polling worker saat antrian kosong, sebelum cek job baru lagi
POLL_INTERVAL_SECONDS=2

# Interval (detik) worker melakukan pengecekan job stale/macet
RECOVERY_CHECK_INTERVAL_SECONDS=60

# Jumlah maksimal job laporan yang dikerjakan bersamaan dalam 1 container
MAX_CONCURRENT_WORKERS=3